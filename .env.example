# Copy to .env and fill in. Never commit .env.

# OpenAI API key (platform.openai.com; a ChatGPT subscription is not an API key)
OPENAI_API_KEY=

# Local PostgreSQL + pgvector (docker-compose.yml reads these too)
POSTGRES_USER=mmrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mmrag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mmrag:change-me@localhost:5433/mmrag

# Kaggle API token (kaggle.com > Settings > API > Create New Token), used to run the GPU captioning job
KAGGLE_API_TOKEN=
